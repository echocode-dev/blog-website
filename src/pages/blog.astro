---
import BaseLayout from "../layouts/BaseLayout.astro";
import SearchBox from "../components/SearchBox.astro";
import BlogPostCard from "../components/BlogPostCard.astro";
import { getCollection } from "astro:content";

const pageTitle = " - Blog";
// TODO: add proper description.
const description = "This is a description.";

const allPosts = await getCollection("blog");
---

<BaseLayout pageTitle={pageTitle} description={description}>
    <main class="posts-container">
        <h2>Blog</h2>

        <div class="search-box-container">
            <SearchBox />
        </div>

        <div class="posts-list">
            {allPosts.map((post) => <BlogPostCard frontmatter={post.data} url={`/posts/${post.id}/`} />)}
        </div>
    </main>
</BaseLayout>

<style>
    .posts-container {
        display: flex;
        flex-direction: column;
        padding: 1rem;
        margin: 1rem 0.5rem;
        border: 1px solid var(--text-main);
        border-radius: 5px;
        background-color: var(--bg-content);
        justify-content: center;
    }

    .search-box-container :global(.search-btn),
    .search-box-container :global(.search-container) :global(input) {
        background-color: var(--bg-page);
        color: var(--text-main) !important;
        border-color: var(--text-main) !important;
    }

    .posts-list {
        display: flex;
        flex-direction: column;
        margin: 2rem 0;
        gap: 2rem;
    }

    @media screen and (min-width: 894px) {
        .posts-container {
            margin: 1rem 2rem;
        }

        .posts-list {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(450px, 1fr));
        }
    }
</style>
