---
import { useTranslations } from "../../i18n/utils";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Hero from "../../components/Hero.astro";
import pageHeaderBackground from "../../assets/code.jpg";

export { getStaticPaths } from "../../i18n/utils";

const lang = Astro.params.lang as import("../../i18n/ui").Locale;
const t = useTranslations(lang);
const unknownDateTranslation = t("card.info.unknownDate");
---

<BaseLayout
    lang={lang}
    pageTitle={t("page.search.title")}
    description={t("page.search.desc")}
    image={pageHeaderBackground}
>
    <main
        id="search-main"
        class="container"
        data-msg-query-filters={t("page.search.empty.queryFilters")}
        data-msg-query={t("page.search.empty.query")}
        data-msg-filters={t("page.search.empty.filters")}
        data-msg-error={t("page.search.error")}
    >
        <Hero lang={lang} />

        <section class="recents">
            <div class="recents-header">
                <h2>{t("page.search.results")}</h2>
            </div>

            <div id="search-results"></div>
        </section>
    </main>
</BaseLayout>

<template id="search-card-template">
    <a class="card" href="">
        <div class="card-info">
            <h3 class="card-title"></h3>
            <div class="card-date">
                <svg
                    class="icon-sm"
                    xmlns="http://www.w3.org/2000/svg"
                    width="20"
                    height="20"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    ><path d="M8 2v4"></path><path d="M16 2v4"></path><rect width="18" height="18" x="3" y="4" rx="2"
                    ></rect><path d="M3 10h18"></path></svg
                >
                <p class="date-text"></p>
            </div>
            <p class="card-summary"></p>
        </div>
        <div class="card-footer">
            <p>Read more</p>
            <svg
                class="icon-sm"
                xmlns="http://www.w3.org/2000/svg"
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg
            >
        </div>
    </a>
</template>

<style>
    :global(.card-summary mark) {
        background-color: color-mix(in srgb, var(--color-secondary) 40%, transparent);
        color: var(--text-main);
        border-radius: 4px;
        padding: 0 0.2rem;
        font-weight: 600;
    }

    .container {
        display: flex;
        flex-direction: column;
        margin: 1rem 0.5rem;
        border: 1px solid var(--text-main);
        border-radius: 12px;
        background-color: var(--bg-content);
        gap: 2rem;
    }

    .recents {
        display: flex;
        flex-direction: column;
        gap: 2rem;
        margin: 0 1rem 2rem;
    }

    .recents-header {
        display: flex;
        align-items: center;
        gap: 3rem;
        text-align: center;
    }

    .recents-header::before,
    .recents-header::after {
        content: "";
        flex: 1;
        height: 1px;
        background-color: var(--text-main);
    }

    .recents-header h2 {
        margin: 0;
    }

    #search-results {
        display: flex;
        flex-direction: column;
        gap: 2rem;
        align-items: center;
        color: var(--text-subtle);
    }

    .card {
        display: flex;
        flex-direction: column;
        padding: 1.5rem 1rem;
        border-radius: 10px;
        border: 1px solid var(--text-subtle);
        background-color: var(--bg-page);
        text-decoration: none;
        justify-content: space-between;
        min-height: 200px;
        transition: border-color 0.3s ease;
    }

    @media (hover: hover) {
        .card:hover {
            border-color: var(--text-main);
        }
    }

    .card-info {
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }

    .card-title {
        display: -webkit-box;
        -webkit-line-clamp: 1;
        -webkit-box-orient: vertical;
        overflow: hidden;
        margin: 0;
        color: var(--text-main);
    }

    .card-summary {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
        margin: 0;
        font-weight: 400;
        color: var(--text-secondary);
    }

    .card-date {
        display: flex;
        gap: 0.4rem;
        align-items: center;
        color: var(--text-subtle);
        height: 0.9rem;
    }

    .card-date p {
        margin: 0;
        font-size: 0.9rem;
    }

    .card-footer {
        display: flex;
        align-items: center;
        justify-content: flex-end;
        gap: 0.5rem;
        margin-top: 1rem;
    }

    .card-footer p {
        margin: 0;
    }

    .icon-sm {
        width: 20px;
        height: 20px;
    }

    @media screen and (min-width: 894px) {
        .container {
            flex: 1;
            margin: 1rem 2.5rem;
        }

        .recents-header {
            margin: 0 4rem;
        }

        #search-results {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(450px, 1fr));
            margin: 0 4rem;
        }
    }
</style>

<script is:inline define:vars={{ unknownDateTranslation }}>
    const mainContainer = document.getElementById("search-main");

    const msgQueryFilters = mainContainer ? mainContainer.getAttribute("data-msg-query-filters") : "";
    const msgQuery = mainContainer ? mainContainer.getAttribute("data-msg-query") : "";
    const msgFilters = mainContainer ? mainContainer.getAttribute("data-msg-filters") : "";
    const msgError = mainContainer ? mainContainer.getAttribute("data-msg-error") : "";

    async function runSearch() {
        try {
            const params = new URLSearchParams(window.location.search);
            const query = params.get("q") || "";

            const activeFilters = {};

            for (const [key, value] of params.entries()) {
                if (key.startsWith("filter_")) {
                    const category = key.replace("filter_", "");
                    activeFilters[category] = value.split(",");
                }
            }

            const hasFilters = Object.keys(activeFilters).length > 0;

            if (!query && !hasFilters) {
                window.location.replace("/");
                return;
            }

            const resultsContainer = document.querySelector("#search-results");
            if (!resultsContainer) return;

            if (query) {
                document.querySelectorAll('input[name="q"]').forEach((input) => {
                    input.value = query;
                });
            }

            // @ts-ignore
            const pagefind = await import("/pagefind/pagefind.js");
            await pagefind.init();

            const searchQuery = query.trim() === "" ? null : query;

            const search = await pagefind.search(searchQuery, { filters: activeFilters });

            if (search.results.length === 0) {
                if (query) {
                    if (Object.keys(activeFilters).length > 0) {
                        resultsContainer.innerHTML = `<h4>${msgQueryFilters.replace("{query}", query)}</h4>`;
                        return;
                    }

                    resultsContainer.innerHTML = `<h4>${msgQuery.replace("{query}", query)}</h4>`;
                } else {
                    resultsContainer.innerHTML = `<h4>${msgFilters}</h4>`;
                }

                return;
            }

            const resultsData = await Promise.all(search.results.map((r) => r.data()));

            const fragment = document.createDocumentFragment();
            const template = document.getElementById("search-card-template");

            if (!template) {
                console.error("Search template not found");
                return;
            }

            for (const data of resultsData) {
                const clone = template.content.cloneNode(true);

                clone.querySelector(".card").href = data.url;
                clone.querySelector(".card-title").textContent = data.meta.title;

                clone.querySelector(".card-summary").innerHTML = data.excerpt;

                clone.querySelector(".date-text").textContent =
                    data.meta.pubDate || data.meta.updatedDate || unknownDateTranslation;

                fragment.appendChild(clone);
            }

            resultsContainer.innerHTML = "";
            resultsContainer.appendChild(fragment);
        } catch (error) {
            console.error("Pagefind failed:", error);
            resultsContainer.innerHTML = `<h4>${msgError}</h4>`;
        }
    }

    runSearch();
</script>
