---
import { useTranslations } from "../../i18n/utils";
import { getRelativeLocaleUrl } from "astro:i18n";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Hero from "../../components/Hero.astro";
import BlogPostCard from "../../components/BlogPostCard.astro";
import Newsletter from "../../components/Newsletter.astro";
import pageHeaderBackground from "../../assets/code.jpg";
import { getCollection } from "astro:content";

export { getStaticPaths } from "../../i18n/utils";

const lang = Astro.params.lang as import("../../i18n/ui").Locale;
const t = useTranslations(lang);

const allPosts = await getCollection("blog", ({ id }) => id.startsWith(`${lang}/`));
const sortedPosts = allPosts.sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());
---

<BaseLayout lang={lang} pageTitle={t("page.home.title")} description={t("page.home.desc")} image={pageHeaderBackground}>
    <main class="container">
        <Hero lang={lang} />

        <div class="ad-placeholder" hidden>
            <p>AD PLACEHOLDER</p>
        </div>

        <section id="recents" class="recents">
            <div class="recents-header">
                <h2>{t("page.home.recents")}</h2>
            </div>

            <div class="posts-grid">
                {
                    sortedPosts.map((post) => {
                        const slug = post.id.split("/").slice(1).join("/");
                        return (
                            <BlogPostCard
                                lang={lang}
                                frontmatter={post.data}
                                url={getRelativeLocaleUrl(lang, `posts/${slug}`)}
                            />
                        );
                    })
                }
            </div>
        </section>

        <div class="newsletter-container">
            <Newsletter lang={lang} />
        </div>
    </main>
</BaseLayout>

<style>
    .container {
        display: flex;
        flex-direction: column;
        margin: 1rem 0.5rem;
        border: 1px solid var(--text-main);
        border-radius: 12px;
        background-color: var(--bg-content);
        gap: 2rem;
    }

    .ad-placeholder {
        border: 1px solid var(--text-main);
        border-radius: 10px;
        padding: 1rem;
        background-color: var(--bg-page);
        height: 125px;
        margin: 0 1rem;
    }

    .recents {
        display: flex;
        flex-direction: column;
        gap: 2rem;
        margin: 0 1rem;
    }

    .recents-header {
        display: flex;
        align-items: center;
        gap: 3rem;
        text-align: center;
        text-transform: uppercase;
    }

    .recents-header::before,
    .recents-header::after {
        content: "";
        flex: 1;
        height: 1px;
        background-color: var(--text-main);
    }

    .recents-header h2 {
        margin: 0;
    }

    .posts-grid {
        display: flex;
        flex-direction: column;
        gap: 2rem;
    }

    .newsletter-container {
        display: flex;
        margin: 0 1rem 2rem;
    }

    @media screen and (min-width: 894px) {
        .recents {
            margin: 0 4rem;
        }

        .newsletter-container {
            margin: 0 4rem 2rem;
        }

        .container {
            flex: 1;
            margin: 1rem 2.5rem;
        }

        .ad-placeholder {
            height: 150px;
        }

        .posts-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(450px, 1fr));
        }
    }
</style>
