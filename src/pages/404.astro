---
import { useTranslations } from "../i18n/utils";
import { defaultLang } from "../i18n/ui";
import BaseLayout from "../layouts/BaseLayout.astro";

const t = useTranslations(defaultLang);
---

<BaseLayout lang={defaultLang} pageTitle={t("page.404.title")} description={t("page.404.desc")}>
    <main class="page-container">
        <h1>{t("page.404.heading")}</h1>
        <h3>{t("page.404.msg")}</h3>
    </main>
</BaseLayout>

<style>
    .page-container {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        flex: 1;
    }

    .page-container h1 {
        margin: 0;
        font-size: 10rem;
    }
</style>
