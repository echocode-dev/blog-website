---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import BlogPostCard from "../components/BlogPostCard.astro";
import pageHeaderBackground from "../assets/code.jpg";
import { getCollection } from "astro:content";
import { SITE_DESCRIPTION } from "../consts";

const pageTitle = "Home";

const allPosts = await getCollection("blog");
const sortedPosts = allPosts.sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());
---

<BaseLayout pageTitle={pageTitle} description={SITE_DESCRIPTION} image={pageHeaderBackground}>
    <main class="container">
        <Hero />

        <div class="ad-placeholder">
            <p>AD PLACEHOLDER</p>
        </div>

        <section id="recents" class="recents">
            <div class="recents-header">
                <h2>RECENTS</h2>
            </div>

            <div class="posts-grid">
                {sortedPosts.map((post) => <BlogPostCard frontmatter={post.data} url={`/posts/${post.id}/`} />)}
            </div>
        </section>
    </main>
</BaseLayout>

<style>
    .container {
        display: flex;
        flex-direction: column;
        margin: 1rem 0.5rem;
        border: 1px solid var(--text-main);
        border-radius: 12px;
        background-color: var(--bg-content);
        gap: 2rem;
    }

    .ad-placeholder {
        border: 1px solid var(--text-main);
        border-radius: 10px;
        padding: 1rem;
        background-color: var(--bg-page);
        height: 125px;
        margin: 0 1rem;
    }

    .recents {
        display: flex;
        flex-direction: column;
        gap: 2rem;
        margin: 0 1rem 2rem;
    }

    .recents-header {
        display: flex;
        align-items: center;
        gap: 3rem;
        text-align: center;
    }

    .recents-header::before,
    .recents-header::after {
        content: "";
        flex: 1;
        height: 1px;
        background-color: var(--text-main);
    }

    .recents-header h2 {
        margin: 0;
    }

    .posts-grid {
        display: flex;
        flex-direction: column;
        gap: 2rem;
    }

    @media screen and (min-width: 894px) {
        .container {
            flex: 1;
            margin: 1rem 2.5rem;
        }

        .ad-placeholder {
            height: 150px;
        }

        .recents-header {
            margin: 0 4rem;
        }

        .posts-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(450px, 1fr));
            margin: 0 4rem;
        }
    }
</style>
