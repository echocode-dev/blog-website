---
import BaseLayout from "../layouts/BaseLayout.astro";
import SearchBox from "../components/SearchBox.astro";
import FilterButton from "../components/FilterButton.astro";
import BlogPostCard from "../components/BlogPostCard.astro";
import pageHeaderBackground from "../assets/code.jpg";
import { getCollection } from "astro:content";
import { getImage } from "astro:assets";
import { SITE_TITLE, SITE_DESCRIPTION } from "../consts";

const pageTitle = "Home";

const allPosts = await getCollection("blog");
const sortedPosts = allPosts.sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());

const bgImage = await getImage({ src: pageHeaderBackground, format: "webp" });
---

<BaseLayout pageTitle={pageTitle} description={SITE_DESCRIPTION} image={pageHeaderBackground}>
    <main class="container">
        <header class="hero" style={`--bg-image: url(${bgImage.src})`}>
            <div class="hero-content">
                <div class="filter-wrapper" hidden>
                    <FilterButton />
                </div>

                <h1>{SITE_TITLE} News</h1>

                <div class="search-wrapper">
                    <SearchBox />
                </div>
            </div>
        </header>

        <div class="ad-placeholder">
            <p>AD PLACEHOLDER</p>
        </div>

        <section id="recents" class="recents">
            <div class="recents-header">
                <h2>RECENTS</h2>
            </div>

            <div class="posts-grid">
                {sortedPosts.map((post) => <BlogPostCard frontmatter={post.data} url={`/posts/${post.id}/`} />)}
            </div>
        </section>
    </main>
</BaseLayout>

<style>
    .container {
        display: flex;
        flex-direction: column;
        margin: 1rem 0.5rem;
        border: 1px solid var(--text-main);
        border-radius: 12px;
        background-color: var(--bg-content);
        gap: 2rem;
    }

    .hero {
        display: flex;
        justify-content: flex-end;
        align-items: flex-end;
        height: 325px;
        padding: 1rem;
        border-radius: 10px;
        margin: 10px 10px 0;
        position: relative;
        z-index: 1;
    }

    .hero::before {
        content: "";
        position: absolute;
        inset: 0;
        z-index: -1;
        border-radius: inherit;
        background-image: linear-gradient(to top, black 50%, transparent), var(--bg-image);
        background-repeat: no-repeat;
        background-size: cover;
        background-position: center center;
    }

    .hero-content {
        display: grid;
        grid-template-columns: auto 1fr;
        gap: 1rem;
        width: 100%;
        align-items: center;
        margin-bottom: 10px;
    }

    .hero-content h1 {
        color: var(--text-navbar);
        grid-column: 1 / -1;
        grid-row: 1;
        text-align: center;
        margin: 0;
        font-size: 1.5rem;
    }

    .filter-wrapper {
        grid-column: 1;
        grid-row: 2;
    }
    .search-wrapper {
        grid-column: 2;
        grid-row: 2;
        display: flex;
        flex-direction: column;
    }

    .ad-placeholder {
        border: 1px solid var(--text-main);
        border-radius: 10px;
        padding: 1rem;
        background-color: var(--bg-page);
        height: 125px;
        margin: 0 1rem;
    }

    .recents {
        display: flex;
        flex-direction: column;
        gap: 2rem;
        margin: 0 1rem 2rem;
    }

    .recents-header {
        display: flex;
        align-items: center;
        gap: 3rem;
        text-align: center;
    }

    .recents-header::before,
    .recents-header::after {
        content: "";
        flex: 1;
        height: 1px;
        background-color: var(--text-main);
    }

    .recents-header h2 {
        margin: 0;
    }

    .posts-grid {
        display: flex;
        flex-direction: column;
        gap: 2rem;
    }

    @media screen and (min-width: 894px) {
        .container {
            flex: 1;
            margin: 1rem 2.5rem;
        }

        .hero {
            align-items: center;
            margin: 15px 15px 0;
        }

        .hero::before {
            background-image: linear-gradient(to left, black, transparent), var(--bg-image);
        }

        .hero-content {
            grid-template-columns: auto 1fr;
            grid-template-rows: auto auto;
            gap: 0.5rem 1rem;
            align-items: end;
            margin-right: 2rem;
            width: auto;
            min-width: 500px;
        }

        .hero-content h1 {
            grid-column: 2;
            grid-row: 1;
            text-align: left;
        }

        .ad-placeholder {
            height: 150px;
        }
        .recents-header {
            margin: 0 4rem;
        }

        .posts-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(450px, 1fr));
            margin: 0 4rem;
        }
    }
</style>
