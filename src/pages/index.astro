---
import { getLangFromUrl, useTranslations } from "../i18n/utils";
import { defaultLang } from "../i18n/ui";
import BaseHead from "../components/BaseHead.astro";
import pageHeaderBackground from "../assets/code.jpg";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<script is:inline define:vars={{ defaultLang }}>
    const storedLang = localStorage.getItem("lang") || defaultLang;

    window.location.replace(`/${storedLang}/`);
</script>

<head>
    <BaseHead pageTitle={t("page.home.title")} description={t("page.home.desc")} image={pageHeaderBackground} />
</head>
<body></body>

<style>
    body {
        background-color: #1d2d44;
    }
</style>
