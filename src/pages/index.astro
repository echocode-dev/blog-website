---
import BaseLayout from "../layouts/BaseLayout.astro";
import SearchBox from "../components/SearchBox.astro";
import FilterButton from "../components/FilterButton.astro";
import BlogPostCard from "../components/BlogPostCard.astro";
import { getCollection } from "astro:content";

const pageTitle = " - Home";
const description = "Checkout everything that Echo Code has to offer!";

const allPosts = await getCollection("blog");
---

<BaseLayout pageTitle={pageTitle} description={description}>
    <main class="posts-container">
        <header class="posts-container-header">
            <div class="posts-action">
                <div class="filter-container" hidden>
                    <FilterButton />
                </div>

                <h1>Echo Code News</h1>

                <div class="search-box-container">
                    <SearchBox />
                </div>
            </div>
        </header>

        <div class="ad">
            <p>AD PLACEHOLDER</p>
        </div>

        <div class="recent-posts-container" id="recents">
            <div class="recents-title">
                <h2>RECENTS</h2>
            </div>

            <div class="posts-list">
                {
                    allPosts
                        .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
                        .map((post) => <BlogPostCard frontmatter={post.data} url={`/posts/${post.id}/`} />)
                }
            </div>
        </div>
    </main>
</BaseLayout>

<style>
    .posts-container {
        display: flex;
        flex-direction: column;
        margin: 1rem 0.5rem;
        border: 1px solid var(--text-main);
        border-radius: 12px;
        background-color: var(--bg-content);
        gap: 2rem;
    }

    .posts-container-header {
        display: flex;
        flex-direction: column;
        justify-content: flex-end;
        align-items: flex-end;
        height: 325px;
        padding: 1rem;
        border-radius: 10px;
        margin: 10px 10px 0;

        position: relative;
        z-index: 1;
    }

    .posts-container-header::before {
        content: "";
        position: absolute;

        inset: 0;
        z-index: -1;
        border-radius: inherit;

        background-image: linear-gradient(to top, black 50%, transparent), url("../assets/code.jpg");
        background-repeat: no-repeat;
        background-size: cover;
        background-position: center center;
    }

    .posts-action {
        display: grid;
        grid-template-columns: auto 1fr;
        gap: 1rem;
        width: 100%;
        align-items: center;
        margin-bottom: 10px;
    }

    .posts-action h1 {
        color: var(--text-navbar);
        grid-column: 1 / -1;
        grid-row: 1;
        text-align: center;
        margin: 0;
        font-size: 1.5rem;
    }

    .filter-container {
        grid-column: 1;
        grid-row: 2;
    }

    .search-box-container {
        display: flex;
        flex-direction: column;
        grid-column: 2;
        grid-row: 2;
    }

    .ad {
        border: 1px solid var(--text-main);
        border-radius: 10px;
        padding: 1rem;
        background-color: var(--bg-page);
        height: 125px;
        margin: 0 1rem;
    }

    .posts-action :global(.search-btn),
    .posts-action :global(.search-container) :global(input),
    .posts-action :global(.filter-btn) {
        background-color: var(--bg-page);
        color: var(--text-main) !important;
        border-color: var(--text-main) !important;
    }

    .recent-posts-container {
        display: flex;
        flex-direction: column;
        gap: 2rem;
        margin: 0 1rem;
    }

    .recents-title {
        display: flex;
        flex-direction: row;
        justify-content: center;
        align-items: center;
        gap: 3rem;
    }

    .recents-title::before {
        content: "";
        flex-grow: 1;
        height: 1px;
        background-color: var(--text-main);
    }

    .recents-title h2 {
        margin: 0;
    }

    .recents-title::after {
        content: "";
        flex-grow: 1;
        height: 1px;
        background-color: var(--text-main);
    }

    .posts-list {
        display: flex;
        flex-direction: column;
        gap: 2rem;
        margin-bottom: 2rem;
    }

    @media screen and (min-width: 894px) {
        .posts-container {
            flex: 1;
            margin: 1rem 2.5rem;
        }

        .posts-container-header {
            display: flex;
            flex-direction: row;
            align-items: center;
            justify-content: flex-end;
            margin: 15px 15px 0;
        }

        .posts-container-header::before {
            background-image: linear-gradient(to left, black, transparent), url("../assets/code.jpg");
        }

        .posts-action {
            grid-template-columns: auto 1fr;
            grid-template-rows: auto auto;
            gap: 0.5rem 1rem;
            align-items: end;
            margin-right: 2rem;
            min-width: 500px;
            width: auto;
            margin-bottom: initial;
        }

        .filter-container {
            grid-column: 1;
            grid-row: 2;
        }

        .posts-action h1 {
            grid-column: 2;
            grid-row: 1;
            text-align: left;
        }

        .search-box-container {
            grid-column: 2;
            grid-row: 2;
        }

        .ad {
            height: 150px;
        }

        .recents-title {
            margin: 0 4rem;
        }

        .posts-list {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(450px, 1fr));
            margin: 0 4rem 2rem;
        }
    }
</style>
