---
import BaseLayout from "../layouts/BaseLayout.astro";
import FilterButton from "../components/FilterButton.astro";
import SearchBox from "../components/SearchBox.astro";
import pageHeaderBackground from "../assets/code.jpg";
import { getImage } from "astro:assets";
import { SITE_TITLE } from "../consts";

const pageTitle = " - Search Results";
const description = "Search the Echo Code blog.";

const bgImage = await getImage({ src: pageHeaderBackground, format: "webp" });
---

<BaseLayout pageTitle={pageTitle} description={description} image={pageHeaderBackground}>
    <main class="container">
        <header class="hero" style={`--bg-image: url(${bgImage.src})`}>
            <div class="hero-content">
                <div class="filter-wrapper" hidden>
                    <FilterButton />
                </div>
                <h1>{SITE_TITLE} News</h1>
                <div class="search-wrapper">
                    <SearchBox />
                </div>
            </div>
        </header>

        <section class="recents">
            <div class="recents-header">
                <h2>RESULTS</h2>
            </div>

            <div id="search-results"></div>
        </section>
    </main>
</BaseLayout>

<template id="search-card-template">
    <a class="card" href="">
        <div class="card-info">
            <h3 class="card-title"></h3>
            <div class="card-date">
                <svg
                    class="icon-sm"
                    xmlns="http://www.w3.org/2000/svg"
                    width="20"
                    height="20"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    ><path d="M8 2v4"></path><path d="M16 2v4"></path><rect width="18" height="18" x="3" y="4" rx="2"
                    ></rect><path d="M3 10h18"></path></svg
                >
                <p class="date-text"></p>
            </div>
            <p class="card-summary"></p>
        </div>
        <div class="card-footer">
            <p>Read more</p>
            <svg
                class="icon-sm"
                xmlns="http://www.w3.org/2000/svg"
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg
            >
        </div>
    </a>
</template>

<script is:inline>
    document.addEventListener("astro:page-load", () => {
        const params = new URLSearchParams(window.location.search);
        const query = params.get("q");

        if (!query) {
            window.location.replace("/");
            return;
        }

        const resultsContainer = document.querySelector("#search-results");
        if (!resultsContainer) return;

        document.querySelectorAll('input[name="q"]').forEach((input) => {
            input.value = query;
        });

        async function runSearch() {
            try {
                // @ts-ignore
                const pagefind = await import("/pagefind/pagefind.js");
                await pagefind.init();

                const search = await pagefind.search(query);

                if (search.results.length === 0) {
                    resultsContainer.innerHTML = `<h4>No posts found for "${query}".</h4>`;
                    return;
                }

                const resultsData = await Promise.all(search.results.map((r) => r.data()));

                const fragment = document.createDocumentFragment();
                const template = document.getElementById("search-card-template");

                if (!template) {
                    console.error("Search template not found");
                    return;
                }

                for (const data of resultsData) {
                    const clone = template.content.cloneNode(true);

                    clone.querySelector(".card").href = data.url;
                    clone.querySelector(".card-title").textContent = data.meta.title;

                    clone.querySelector(".card-summary").innerHTML = data.excerpt;

                    clone.querySelector(".date-text").textContent = data.meta.pubDate || "Unknown Date";

                    fragment.appendChild(clone);
                }

                resultsContainer.innerHTML = "";
                resultsContainer.appendChild(fragment);
            } catch (error) {
                console.error("Pagefind failed:", error);
                resultsContainer.innerHTML = `<h4>Search is currently unavailable.</h4>`;
            }
        }

        runSearch();
    });
</script>

<style>
    :global(.card-summary mark) {
        background-color: color-mix(in srgb, var(--color-secondary) 40%, transparent);
        color: var(--text-main);
        border-radius: 4px;
        padding: 0 0.2rem;
        font-weight: 600;
    }

    .container {
        display: flex;
        flex-direction: column;
        margin: 1rem 0.5rem;
        border: 1px solid var(--text-main);
        border-radius: 12px;
        background-color: var(--bg-content);
        gap: 2rem;
    }

    .hero {
        display: flex;
        justify-content: flex-end;
        align-items: flex-end;
        height: 325px;
        padding: 1rem;
        border-radius: 10px;
        margin: 10px 10px 0;
        position: relative;
        z-index: 1;
    }

    .hero::before {
        content: "";
        position: absolute;
        inset: 0;
        z-index: -1;
        border-radius: inherit;
        background-image: linear-gradient(to top, black 50%, transparent), var(--bg-image);
        background-repeat: no-repeat;
        background-size: cover;
        background-position: center center;
    }

    .hero-content {
        display: grid;
        grid-template-columns: auto 1fr;
        gap: 1rem;
        width: 100%;
        align-items: center;
        margin-bottom: 10px;
    }

    .hero-content h1 {
        color: var(--text-navbar);
        grid-column: 1 / -1;
        grid-row: 1;
        text-align: center;
        margin: 0;
        font-size: 1.5rem;
    }

    .filter-wrapper {
        grid-column: 1;
        grid-row: 2;
    }
    .search-wrapper {
        grid-column: 2;
        grid-row: 2;
        display: flex;
        flex-direction: column;
    }

    .recents {
        display: flex;
        flex-direction: column;
        gap: 2rem;
        margin: 0 1rem 2rem;
    }

    .recents-header {
        display: flex;
        align-items: center;
        gap: 3rem;
        text-align: center;
    }

    .recents-header::before,
    .recents-header::after {
        content: "";
        flex: 1;
        height: 1px;
        background-color: var(--text-main);
    }

    .recents-header h2 {
        margin: 0;
    }

    #search-results {
        display: flex;
        flex-direction: column;
        gap: 2rem;
    }

    .card {
        display: flex;
        flex-direction: column;
        padding: 1.5rem 1rem;
        border-radius: 10px;
        border: 1px solid var(--text-subtle);
        background-color: var(--bg-page);
        text-decoration: none;
        justify-content: space-between;
        min-height: 200px;
        transition: border-color 0.3s ease;
    }

    .card:hover {
        border-color: var(--text-main);
    }
    .card-info {
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }

    .card-title {
        display: -webkit-box;
        -webkit-line-clamp: 1;
        -webkit-box-orient: vertical;
        overflow: hidden;
        margin: 0;
    }

    .card-summary {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
        margin: 0;
        font-weight: 400;
        color: var(--text-secondary);
    }

    .card-date {
        display: flex;
        gap: 0.4rem;
        align-items: center;
        color: var(--text-subtle);
        height: 0.9rem;
    }
    .card-date p {
        margin: 0;
        font-size: 0.9rem;
    }

    .card-footer {
        display: flex;
        align-items: center;
        justify-content: flex-end;
        gap: 0.5rem;
        margin-top: 1rem;
    }
    .card-footer p {
        margin: 0;
    }

    .icon-sm {
        width: 20px;
        height: 20px;
    }

    @media screen and (min-width: 894px) {
        .container {
            flex: 1;
            margin: 1rem 2.5rem;
        }

        .hero {
            align-items: center;
            margin: 15px 15px 0;
        }
        .hero::before {
            background-image: linear-gradient(to left, black, transparent), var(--bg-image);
        }

        .hero-content {
            grid-template-columns: auto 1fr;
            grid-template-rows: auto auto;
            gap: 0.5rem 1rem;
            align-items: end;
            margin-right: 2rem;
            width: auto;
            min-width: 500px;
        }

        .hero-content h1 {
            grid-column: 2;
            grid-row: 1;
            text-align: left;
        }

        .recents-header {
            margin: 0 4rem;
        }
        #search-results {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(450px, 1fr));
            margin: 0 4rem;
        }
    }
</style>
