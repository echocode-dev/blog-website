---
import BaseLayout from "../layouts/BaseLayout.astro";
import FilterButton from "../components/FilterButton.astro";
import SearchBox from "../components/SearchBox.astro";
import pageHeaderBackground from "../assets/code.jpg";

const pageTitle = " - Search Results";
const description = "Search the Echo Code blog.";
---

<BaseLayout pageTitle={pageTitle} description={description} image={pageHeaderBackground}>
    <main class="posts-container">
        <header class="posts-container-header" style={`--bg-image: url(${pageHeaderBackground.src})`}>
            <div class="posts-action">
                <div class="filter-container" hidden>
                    <FilterButton />
                </div>
                <h1>Echo Code News</h1>
                <div class="search-box-container">
                    <SearchBox />
                </div>
            </div>
        </header>

        <div class="recent-posts-container">
            <div class="recents-title">
                <h2>RESULTS</h2>
            </div>

            <div id="search-results"></div>
        </div>
    </main>
</BaseLayout>

<script is:inline>
    document.addEventListener("astro:page-load", () => {
        const params = new URLSearchParams(window.location.search);
        const query = params.get("q");

        if (!query) {
            window.location.replace("/");
            return;
        }

        const resultsContainer = document.querySelector("#search-results");

        if (query && resultsContainer) {
            const searchInputs = document.querySelectorAll('input[name="q"]');

            searchInputs.forEach((input) => {
                input.value = query;
            });

            async function runSearch() {
                try {
                    const pagefind = await import("/pagefind/pagefind.js");
                    await pagefind.init();

                    const search = await pagefind.search(query);

                    if (search.results.length === 0) {
                        resultsContainer.innerHTML = `<h4>No posts found for "${query}".</h4>`;
                        return;
                    }

                    resultsContainer.innerHTML = "";

                    for (const result of search.results) {
                        const data = await result.data();

                        const title = data.meta.title;
                        const summary = data.excerpt;
                        const url = data.url;

                        const date = data.meta.pubDate || "Unknown Date";

                        resultsContainer.innerHTML += `
                        <a class="post-card" href="${url}">
                            <div class="post-info">
                                <h3 class="post-title">${title}</h3>
                                <div class="post-date">
                                    <svg class="calendar-icon" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M8 2v4"/><path d="M16 2v4"/><rect width="18" height="18" x="3" y="4" rx="2"/><path d="M3 10h18"/></svg>
                                    <p>${date}</p>
                                </div>
                                <p class="post-summary">${summary}</p>
                            </div>

                            <div class="post-go">
                                <p>Read more</p>
                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
                            </div>
                        </a>
                    `;
                    }
                } catch (error) {
                    console.error("Pagefind failed to load. Have you run the indexer?", error);
                    resultsContainer.innerHTML = `<h4>Search is currently unavailable.</h4>`;
                }
            }

            runSearch();
        }
    });
</script>

<style is:global>
    #search-results {
        display: flex;
        flex-direction: column;
        gap: 2rem;
        margin-bottom: 2rem;
    }

    .post-card {
        display: flex;
        flex-direction: column;
        padding: 1.5rem 1rem;
        border-radius: 10px;
        border: 1px solid var(--text-subtle);
        background-color: var(--bg-page);
        font-style: normal;
        text-decoration: none;
        justify-content: space-between;
        height: 200px;
        transition: border-color 0.3s ease;
    }

    .post-card:hover {
        border-color: var(--text-main);
        transition: border-color 0.3s ease;
    }

    .post-info {
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }

    .post-title {
        display: -webkit-box;
        -webkit-line-clamp: 1;
        -webkit-box-orient: vertical;
        overflow: hidden;
        margin: 0;
    }

    .post-summary {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
        margin: 0;
        font-weight: 400;
        color: var(--text-secondary);
    }

    .post-date {
        display: flex;
        flex-direction: row;
        gap: 0.4rem;
        align-items: center;
        color: var(--text-subtle);
        height: 0.9rem;
    }

    .post-go {
        display: flex;
        flex-direction: row;
        align-items: center;
        justify-content: flex-end;
        gap: 0.5rem;
        margin-top: 1rem;
    }

    .post-date p,
    .post-go p {
        margin: 0;
    }

    .post-date p {
        font-size: 0.9rem;
    }

    .post-date .calendar-icon {
        width: 20px;
        height: 20px;
    }

    @media screen and (min-width: 894px) {
        #search-results {
            margin: 0 4rem 2rem;
        }
    }
</style>

<style>
    .posts-container {
        display: flex;
        flex-direction: column;
        margin: 1rem 0.5rem;
        border: 1px solid var(--text-main);
        border-radius: 12px;
        background-color: var(--bg-content);
        gap: 2rem;
    }

    .posts-container-header {
        display: flex;
        flex-direction: column;
        justify-content: flex-end;
        align-items: flex-end;
        height: 325px;
        padding: 1rem;
        border-radius: 10px;
        margin: 10px 10px 0;

        position: relative;
        z-index: 1;
    }

    .posts-container-header::before {
        content: "";
        position: absolute;

        inset: 0;
        z-index: -1;
        border-radius: inherit;

        background-image: linear-gradient(to top, black 50%, transparent), var(--bg-image);
        background-repeat: no-repeat;
        background-size: cover;
        background-position: center center;
    }

    .posts-action {
        display: grid;
        grid-template-columns: auto 1fr;
        gap: 1rem;
        width: 100%;
        align-items: center;
        margin-bottom: 10px;
    }

    .posts-action h1 {
        color: var(--text-navbar);
        grid-column: 1 / -1;
        grid-row: 1;
        text-align: center;
        margin: 0;
        font-size: 1.5rem;
    }

    .filter-container {
        grid-column: 1;
        grid-row: 2;
    }

    .search-box-container {
        display: flex;
        flex-direction: column;
        grid-column: 2;
        grid-row: 2;
    }

    .ad {
        border: 1px solid var(--text-main);
        border-radius: 10px;
        padding: 1rem;
        background-color: var(--bg-page);
        height: 125px;
        margin: 0 1rem;
    }

    .recent-posts-container {
        display: flex;
        flex-direction: column;
        gap: 2rem;
        margin: 0 1rem;
    }

    .recents-title {
        display: flex;
        flex-direction: row;
        justify-content: center;
        align-items: center;
        gap: 3rem;
    }

    .recents-title::before {
        content: "";
        flex-grow: 1;
        height: 1px;
        background-color: var(--text-main);
    }

    .recents-title h2 {
        margin: 0;
    }

    .recents-title::after {
        content: "";
        flex-grow: 1;
        height: 1px;
        background-color: var(--text-main);
    }

    .posts-list {
        display: flex;
        flex-direction: column;
        gap: 2rem;
    }

    @media screen and (min-width: 894px) {
        .posts-container {
            flex: 1;
            margin: 1rem 2.5rem;
        }

        .posts-container-header {
            display: flex;
            flex-direction: row;
            align-items: center;
            justify-content: flex-end;
            margin: 15px 15px 0;
        }

        .posts-container-header::before {
            background-image: linear-gradient(to left, black, transparent), var(--bg-image);
        }

        .posts-action {
            grid-template-columns: auto 1fr;
            grid-template-rows: auto auto;
            gap: 0.5rem 1rem;
            align-items: end;
            margin-right: 2rem;
            min-width: 500px;
            width: auto;
            margin-bottom: initial;
        }

        .filter-container {
            grid-column: 1;
            grid-row: 2;
        }

        .posts-action h1 {
            grid-column: 2;
            grid-row: 1;
            text-align: left;
        }

        .search-box-container {
            grid-column: 2;
            grid-row: 2;
        }

        .ad {
            height: 150px;
        }

        .recents-title {
            margin: 0 4rem;
        }

        .posts-list {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(450px, 1fr));
            margin: 0 4rem;
        }
    }
</style>
