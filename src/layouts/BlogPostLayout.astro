---
import { getLangFromUrl } from "../i18n/utils";
import { getAbsoluteLocaleUrl } from "astro:i18n";
import { getCollection } from "astro:content";
import TOC from "../components/TOC.astro";
import BaseLayout from "./BaseLayout.astro";
import { Calendar, CircleUserRound } from "@lucide/astro";
import { getRelatedPosts } from "../utils/postHelpers";
import ResponsiveImage from "../components/ResponsiveImage.astro";

const { id, frontmatter, headings } = Astro.props;
const lang = getLangFromUrl(Astro.url);

const options: Intl.DateTimeFormatOptions = { year: "numeric", month: "short", day: "numeric" };

const allPosts = await getCollection("blog", ({ id }) => id.startsWith(`${lang}/`));
const relatedPosts = getRelatedPosts(allPosts, id, frontmatter.tags);

const blogJsonLd = {
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    mainEntityOfPage: {
        "@type": "WebPage",
        "@id": Astro.url.toString(),
    },
    headline: frontmatter.title,
    description: frontmatter.summary,
    image: new URL(frontmatter.cover.src, Astro.url).toString(),
    author: {
        "@type": "Person",
        name: frontmatter.author,
    },
    datePublished: frontmatter.pubDate.toISOString(),
    dateModified: frontmatter.updatedDate ? frontmatter.updatedDate.toISOString() : frontmatter.pubDate.toISOString(),
};
---

<BaseLayout pageTitle={frontmatter.title} description={frontmatter.summary} image={frontmatter.cover}>
    <script is:inline type="application/ld+json" set:html={JSON.stringify(blogJsonLd)} />

    <main class="post-layout" data-pagefind-body>
        {
            headings && headings.length > 0 && (
                <nav class="toc-desktop">
                    <h2 class="widget-title">Table of Content</h2>
                    <TOC headings={headings} />
                </nav>
            )
        }

        <div class="content-wrapper" data-pagefind-body>
            <header>
                <h1>{frontmatter.title}</h1>
                <div class="meta-info">
                    <address class="author">
                        <CircleUserRound class="icon" />
                        <span data-pagefind-filter="author">{frontmatter.author}</span>
                    </address>
                    {
                        frontmatter.updatedDate ? (
                            <time datetime={frontmatter.updatedDate.toISOString()} class="date">
                                <Calendar class="icon" />
                                <span
                                    data-pagefind-filter={`Updated date:${frontmatter.updatedDate.toLocaleDateString(lang, options)}`}
                                    data-pagefind-meta={`updatedDate:${frontmatter.updatedDate.toLocaleDateString(lang, options)}`}
                                >
                                    Updated: {frontmatter.updatedDate.toLocaleDateString(lang, options)}
                                </span>
                            </time>
                        ) : (
                            <time datetime={frontmatter.pubDate.toISOString()} class="date">
                                <Calendar class="icon" />
                                <span
                                    data-pagefind-filter={`Publication date:${frontmatter.pubDate.toLocaleDateString(lang, options)}`}
                                    data-pagefind-meta={`pubDate:${frontmatter.pubDate.toLocaleDateString(lang, options)}`}
                                >
                                    {frontmatter.pubDate.toLocaleDateString(lang, options)}
                                </span>
                            </time>
                        )
                    }
                </div>
                <p class="summary">{frontmatter.summary}</p>
                <ResponsiveImage src={frontmatter.cover} alt={frontmatter.coverAlt} class="cover-image" />
            </header>

            <div class="mobile-only-blocks">
                {
                    headings && headings.length > 0 && (
                        <nav class="toc-mobile">
                            <h2 class="widget-title">Table of Content</h2>
                            <TOC headings={headings} />
                        </nav>
                    )
                }
                <div class="ad-block">
                    <p>AD PLACEHOLDER</p>
                </div>
            </div>

            <article>
                <slot />
            </article>
        </div>

        <aside class="sidebar">
            <div class="related-widget">
                <h2 class="widget-title">Related posts</h2>
                <div class="related-list">
                    {
                        relatedPosts.length > 0 ? (
                            relatedPosts.map((post) => {
                                const slug = post.id.split("/").slice(1).join("/");
                                return (
                                    <div class="related-item">
                                        <a href={getAbsoluteLocaleUrl(lang, `posts/${slug}`)}>{post.data.title}</a>
                                    </div>
                                );
                            })
                        ) : (
                            <p>Nothing to show.</p>
                        )
                    }
                </div>
            </div>

            <div class="ad-block">
                <p>AD PLACEHOLDER</p>
            </div>
        </aside>

        <div id="mobile-related-content-source" style="display: none;">
            <div class="mobile-related-wrapper">
                <h2 class="widget-title">Related posts</h2>
                <div class="related-list">
                    {
                        relatedPosts.length > 0 ? (
                            relatedPosts.map((post) => {
                                const slug = post.id.split("/").slice(1).join("/");
                                return (
                                    <div class="related-item">
                                        <a href={getAbsoluteLocaleUrl(lang, `posts/${slug}`)}>{post.data.title}</a>
                                    </div>
                                );
                            })
                        ) : (
                            <p>Nothing to show.</p>
                        )
                    }
                </div>
            </div>
        </div>
    </main>
</BaseLayout>

<script>
    import { initTOC } from "../utils/tocObserver";

    const injectRelatedPosts = () => {
        const source = document.getElementById("mobile-related-content-source");
        const target = document.getElementById("mobile-related-posts-target");

        if (source && target) {
            target.innerHTML = source.innerHTML;
        }
    };

    injectRelatedPosts();
    initTOC();
</script>

<style is:global>
    .anchor-link {
        text-decoration: none;
        opacity: 0;
        transition: opacity 0.2s;
        margin-left: 0.5rem;
    }

    @media (hover: hover) {
        .anchor:hover > .anchor-link {
            opacity: 0.8;
        }
    }
</style>

<style>
    .post-layout {
        display: flex;
        flex-direction: column;
        padding: 1rem 0.5rem;
        gap: 2rem;
        justify-content: center;
    }

    .content-wrapper {
        display: flex;
        flex-direction: column;
        padding: 1rem;
        border: 1px solid var(--text-main);
        border-radius: 12px;
        background-color: var(--bg-content);
        font-size: 1.1rem;
        height: fit-content;
    }

    .content-wrapper header,
    .content-wrapper article {
        padding: 0 1rem;
    }

    .meta-info {
        display: flex;
        gap: 1.5rem;
        color: var(--text-subtle);
        margin-bottom: 1rem;
    }

    .meta-info p,
    .meta-info span {
        margin: 0;
        font-size: 1rem;
        font-weight: 600;
    }

    .related-list p {
        margin: 0;
        font-size: 1rem;
        font-weight: 500;
    }

    .author,
    .date {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        font-style: normal;
    }

    .icon {
        width: 24px;
        height: 24px;
    }

    .summary {
        font-size: 1.2rem;
    }

    .widget-title {
        margin: 0;
    }

    .cover-image {
        max-width: 100%;
        height: auto;
        border-radius: 10px;
        margin-bottom: 1.5rem;
    }

    .mobile-only-blocks {
        display: flex;
        flex-direction: column;
        gap: 1rem;
        margin: 1.5rem 0;
    }

    .toc-mobile,
    .ad-block {
        display: flex;
        flex-direction: column;
        gap: 1rem;
        width: 100%;
        padding: 1.5rem 1rem;
        border: 1px solid var(--text-main);
        border-radius: 12px;
        background-color: var(--bg-page);
    }

    .toc-desktop,
    .sidebar {
        display: none;
    }

    .mobile-related-wrapper {
        display: flex;
        flex-direction: column;
        gap: 1rem;
        padding: 1.5rem 0.5rem;
    }

    .related-list {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
    }

    @media screen and (min-width: 1200px) {
        .mobile-only-blocks {
            display: none;
        }

        .post-layout {
            flex-direction: row;
            padding: 1rem 2.5rem;
        }

        .content-wrapper {
            min-width: 55%;
            max-width: 55%;
            padding: 1rem 2.5rem;
        }

        .content-wrapper header,
        .content-wrapper article {
            padding: initial;
        }

        .toc-desktop {
            display: flex;
            flex-direction: column;
            gap: 1rem;
            padding: 2rem 1rem;
            height: fit-content;
            position: sticky;
            top: 1rem;
            min-width: 20%;
            max-width: 20%;
            border: 1px solid var(--text-main);
            border-radius: 12px;
            background-color: var(--bg-content);
        }

        .sidebar {
            display: flex;
            flex-direction: column;
            min-width: 20%;
            max-width: 20%;
            flex: 1;
            gap: 2rem;
        }

        .related-widget,
        .ad-block {
            display: flex;
            flex-direction: column;
            gap: 1rem;
            padding: 2rem 1rem;
            border: 1px solid var(--text-main);
            border-radius: 12px;
            background-color: var(--bg-content);
        }

        .toc-desktop h3,
        .related-widget h3 {
            margin: 0;
            margin-bottom: 1rem;
        }
    }
</style>
