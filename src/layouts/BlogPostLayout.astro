---
import { getCollection } from "astro:content";
import TOC from "../components/TOC.astro";
import BaseLayout from "./BaseLayout.astro";

const { frontmatter, headings } = Astro.props;

const allPosts = await getCollection("blog");
const relatedPosts = allPosts
    .filter((post) => post.id !== Astro.params.slug)
    .map((post) => {
        const commonTags = post.data.tags.filter((tag) => frontmatter.tags.includes(tag)).length;

        return { ...post, commonTags };
    })
    .filter((post) => post.commonTags > 0)
    .sort((a, b) => b.commonTags - a.commonTags)
    .slice(0, 5);
---

<BaseLayout pageTitle={frontmatter.title} description={frontmatter.summary}>
    <main class="post-container">
        {
            headings && headings.length > 0 && (
                <nav class="article-toc">
                    <h3>Table of Content</h3>
                    <TOC headings={headings} />
                </nav>
            )
        }

        <div class="post-content-container">
            <section>
                <h1>{frontmatter.title}</h1>
                <p class="post-info">Posted by {frontmatter.author} on {frontmatter.pubDate.toLocaleDateString()}.</p>
                <p class="post-summary">{frontmatter.summary}</p>
            </section>

            <div class="post-content-boxes">
                {
                    headings && headings.length > 0 && (
                        <nav class="mobile-toc">
                            <h3>Table of Content</h3>
                            <TOC headings={headings} />
                        </nav>
                    )
                }

                <div class="mobile-ad">
                    <p>AD PLACEHOLDER</p>
                </div>
            </div>

            <article>
                <slot />
            </article>
        </div>

        <aside class="sidebar">
            <div class="related-posts">
                <h3>Related posts</h3>
                <div class="related-post-list">
                    {
                        relatedPosts.map((post) => (
                            <div class="related-post-item">
                                <a href={`/posts/${post.id}/`}>{post.data.title}</a>
                            </div>
                        ))
                    }
                </div>
            </div>

            <div class="ad">
                <p>AD PLACEHOLDER</p>
            </div>
        </aside>

        <div id="mobile-related-content-source" style="display: none;">
            <div class="mobile-related-wrapper">
                <h3>Recent posts</h3>
                <div class="related-post-list">
                    {
                        relatedPosts.map((post) => (
                            <div class="related-post-item">
                                <a href={`/posts/${post.id}/`}>{post.data.title}</a>
                            </div>
                        ))
                    }
                </div>
            </div>
        </div>
    </main>
</BaseLayout>

<script>
    const injectRelatedPosts = () => {
        const source = document.getElementById("mobile-related-content-source");
        const target = document.getElementById("mobile-related-posts-target");

        if (source && target) {
            target.innerHTML = source.innerHTML;
        }
    };

    document.addEventListener("astro:page-load", injectRelatedPosts);
    injectRelatedPosts();
</script>

<style>
    .post-container {
        display: flex;
        flex-direction: column;
        padding: 1rem 0.5rem;
        gap: 2rem;
        justify-content: center;
    }

    .post-content-container {
        display: flex;
        flex-direction: column;
        padding: 1rem 1rem;
        border: 1px solid var(--text-main);
        border-radius: 5px;
        background-color: var(--bg-content);
        justify-content: center;
        font-size: 1.1rem;
    }

    .post-info {
        color: var(--text-subtle);
    }

    .post-summary {
        font-size: 1.2rem;
    }

    .post-content-container article {
        padding: 0 1rem;
    }

    .post-content-container section {
        padding: 0 1rem;
    }

    .related-post-list {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
        margin-bottom: 1rem;
    }

    .mobile-toc {
        display: block;
        height: fit-content;

        width: 100%;
        box-sizing: border-box;

        padding: 0.5rem 1rem;
        border: 1px solid var(--text-main);
        border-radius: 5px;
        background-color: var(--bg-page);
    }

    .mobile-ad {
        width: 100%;
        height: fit-content;
        padding: 0.5rem 1rem;
        border: 1px solid var(--text-main);
        border-radius: 5px;
        background-color: var(--bg-page);
    }

    .post-content-boxes {
        display: flex;
        flex-direction: column;
        gap: 1rem;
        margin: 1.5rem 0;
    }

    .article-toc {
        display: none;
    }

    .sidebar {
        display: none;
    }

    @media screen and (min-width: 1200px) {
        .post-content-boxes {
            display: none;
        }

        .post-container {
            flex-direction: row;
            padding: 1rem 2.5rem;
        }

        .post-content-container {
            max-width: 60%;
            padding: 1rem 2.5rem;
        }

        .post-content-container article {
            padding: initial;
        }

        .post-content-container section {
            padding: initial;
        }

        .article-toc {
            display: block;
            height: fit-content;
            min-width: 20%;
            max-width: 20%;
            padding: 0.5rem 1rem;
            border: 1px solid var(--text-main);
            border-radius: 5px;
            background-color: var(--bg-content);
        }

        .sidebar {
            display: flex;
            min-width: 20%;
            max-width: 20%;
            flex-direction: column;
            flex: 1;
            gap: 2rem;
        }

        .related-posts {
            height: fit-content;
            padding: 0.5rem 1rem;
            border: 1px solid var(--text-main);
            border-radius: 5px;
            background-color: var(--bg-content);
        }

        .ad {
            width: 100%;
            height: fit-content;
            padding: 0.5rem 1rem;
            border: 1px solid var(--text-main);
            border-radius: 5px;
            background-color: var(--bg-content);
        }
    }
</style>
