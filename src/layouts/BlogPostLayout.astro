---
import TOC from "../components/TOC.astro";
import BaseLayout from "./BaseLayout.astro";

const relatedPosts = [
    { title: "Post A", url: "#" },
    { title: "Post B", url: "#" },
];

const { frontmatter, headings } = Astro.props;
---

<BaseLayout pageTitle={frontmatter.title}>
    <main class="post-container">
        {
            headings && headings.length > 0 && (
                <nav class="article-toc">
                    <h3>Table of Content</h3>
                    <TOC headings={headings} />
                </nav>
            )
        }

        <div class="post-content-container">
            <section>
                <h1>{frontmatter.title}</h1>
                <p>{frontmatter.summary}</p>
            </section>

            <div class="post-content-boxes">
                {
                    headings && headings.length > 0 && (
                        <nav class="mobile-toc">
                            <h3>Table of Content</h3>
                            <TOC headings={headings} />
                        </nav>
                    )
                }

                <div class="mobile-ad">
                    <p>ola soy un anuncio</p>
                </div>
            </div>

            <article>
                <slot />
            </article>
        </div>

        <aside class="sidebar">
            <div class="related-posts">
                <h3>Related posts</h3>
                <ul>
                    {
                        relatedPosts.map((post) => (
                            <li>
                                <a href={post.url}>{post.title}</a>
                            </li>
                        ))
                    }
                </ul>
            </div>

            <div class="ad">
                <p>ola soy un anuncio</p>
            </div>
        </aside>

        <div id="mobile-related-content-source" style="display: none;">
            <div class="mobile-related-wrapper">
                <h3 class="mobile-related-title">Recent posts</h3>
                <ul class="mobile-related-list">
                    {
                        relatedPosts.map((post) => (
                            <li>
                                <a href={post.url}>{post.title}</a>
                            </li>
                        ))
                    }
                </ul>
            </div>
        </div>
    </main>
</BaseLayout>

<script>
    const injectRelatedPosts = () => {
        const source = document.getElementById("mobile-related-content-source");
        const target = document.getElementById("mobile-related-posts-target");

        if (source && target) {
            target.innerHTML = source.innerHTML;
        }
    };

    document.addEventListener("astro:page-load", injectRelatedPosts);
    injectRelatedPosts();
</script>

<style>
    .post-container {
        display: flex;
        flex-direction: column;
        padding: 1rem 0.5rem;
        gap: 2rem;
        justify-content: center;
    }

    .post-content-container {
        display: flex;
        flex-direction: column;
        padding: 1rem 1rem;
        border: 1px solid var(--text-main);
        border-radius: 5px;
        background-color: var(--bg-content);
        justify-content: center;
    }

    .post-content-container article {
        padding: 0 1rem;
    }

    .post-content-container section {
        padding: 0 1rem;
    }

    .mobile-toc {
        display: block;
        height: fit-content;

        width: 100%;
        box-sizing: border-box;

        padding: 0.5rem 1rem;
        border: 1px solid var(--text-main);
        border-radius: 5px;
        background-color: var(--bg-page);
    }

    .mobile-ad {
        width: 100%;
        height: fit-content;
        padding: 0.5rem 1rem;
        border: 1px solid var(--text-main);
        border-radius: 5px;
        background-color: var(--bg-page);
    }

    .post-content-boxes {
        display: flex;
        flex-direction: column;
        gap: 1rem;
        margin: 2rem 0;
    }

    .article-toc {
        display: none;
    }

    .sidebar {
        display: none;
    }

    @media screen and (min-width: 1200px) {
        .post-content-boxes {
            display: none;
        }

        .post-container {
            flex-direction: row;
            padding: 1rem 2.5rem;
        }

        .post-content-container {
            max-width: 60%;
            padding: 1rem 2.5rem;
        }

        .post-content-container article {
            padding: initial;
        }

        .post-content-container section {
            padding: initial;
        }

        .article-toc {
            display: block;
            height: fit-content;
            min-width: 20%;
            max-width: 20%;
            padding: 0.5rem 1rem;
            border: 1px solid var(--text-main);
            border-radius: 5px;
            background-color: var(--bg-content);
        }

        .sidebar {
            display: flex;
            flex-direction: column;
            flex: 1;
            gap: 2rem;
        }

        .related-posts {
            height: fit-content;
            padding: 0.5rem 1rem;
            border: 1px solid var(--text-main);
            border-radius: 5px;
            background-color: var(--bg-content);
        }

        .ad {
            width: 100%;
            height: fit-content;
            padding: 0.5rem 1rem;
            border: 1px solid var(--text-main);
            border-radius: 5px;
            background-color: var(--bg-content);
        }
    }
</style>
