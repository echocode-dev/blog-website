---
import { getRelativeLocaleUrl } from "astro:i18n";
import { getCollection } from "astro:content";
import TOCWidget from "../components/TOCWidget.astro";
import BaseLayout from "./BaseLayout.astro";
import { getRelatedPosts, getBlogJsonLd } from "../utils/helpers";
import ResponsiveImage from "../components/ResponsiveImage.astro";
import RelatedPostsWidget from "../components/RelatedPostsWidget.astro";
import BlogPostMetaInfo from "../components/BlogPostMetaInfo.astro";
import type { CollectionEntry } from "astro:content";
import type { MarkdownHeading } from "astro";
import { LOCALES, type Locale } from "../i18n/ui";
import { useTranslations } from "../i18n/utils";

interface Props {
    lang: Locale;
    id: string;
    frontmatter: CollectionEntry<"blog">["data"];
    headings: MarkdownHeading[];
}

const { lang, id, frontmatter, headings } = Astro.props;
const t = useTranslations(lang);

const allTranslations = await getCollection("blog", (post) => {
    const isSameKey = post.data.translationKey === frontmatter.translationKey;

    const postLang = post.id.split("/")[0] as any;
    const isLocaleActive = LOCALES.includes(postLang);

    return isSameKey && isLocaleActive;
});

const alternateLinks = allTranslations.map((post) => {
    const postLang = post.id.split("/")[0];
    const postSlug = post.data.permalink;
    const url = new URL(getRelativeLocaleUrl(postLang, `posts/${postSlug}`), Astro.url.origin).toString();

    return { lang: postLang, url };
});

const allPosts = await getCollection("blog", ({ id }) => id.startsWith(`${lang}/`));
const relatedPosts = getRelatedPosts(allPosts, id, frontmatter.tags);

const blogJsonLd = getBlogJsonLd(frontmatter, Astro.url.toString());
---

<BaseLayout
    lang={lang}
    pageTitle={frontmatter.title}
    description={frontmatter.summary}
    image={frontmatter.cover}
    alternateLinks={alternateLinks}
>
    <script is:inline type="application/ld+json" set:html={JSON.stringify(blogJsonLd)} />

    <main class="post-layout" data-pagefind-body>
        <aside class="sidebar">
            <TOCWidget headings={headings} tocTitle={t("widget.toc.title")} />
        </aside>

        <div class="content-wrapper" data-pagefind-body>
            <header>
                <div class="category">
                    <span data-pagefind-filter="category">{frontmatter.category}</span>
                </div>

                <h1>{frontmatter.title}</h1>

                <BlogPostMetaInfo
                    lang={lang}
                    author={frontmatter.author}
                    pubDate={frontmatter.pubDate}
                    updatedDate={frontmatter.updatedDate}
                />

                <p class="summary">{frontmatter.summary}</p>
                <ResponsiveImage src={frontmatter.cover} alt={frontmatter.coverAlt} class="cover-image" />
            </header>

            <div class="mobile-only-blocks">
                <TOCWidget headings={headings} tocTitle={t("widget.toc.title")} />
                <div class="ad-block">
                    <p>AD PLACEHOLDER</p>
                </div>
            </div>

            <article>
                <slot />
            </article>
        </div>

        <aside class="sidebar">
            <RelatedPostsWidget lang={lang} relatedPosts={relatedPosts} />

            <div class="ad-block">
                <p>AD PLACEHOLDER</p>
            </div>
        </aside>

        <div id="mobile-related-content-source" style="display: none;">
            <RelatedPostsWidget lang={lang} relatedPosts={relatedPosts} />
        </div>
    </main>
</BaseLayout>

<script>
    import { initTOC } from "../utils/tocObserver";

    const injectRelatedPosts = () => {
        const source = document.getElementById("mobile-related-content-source");
        const target = document.getElementById("mobile-related-posts-target");

        if (source && target) {
            target.innerHTML = source.innerHTML;
        }
    };

    injectRelatedPosts();
    initTOC();
</script>

<style is:global>
    .widget-title {
        margin: 0;
    }

    .anchor a {
        text-decoration: none;
        opacity: 0;
        transition: opacity 0.2s;
        margin-left: 0.5rem;
    }

    @media (hover: hover) {
        .anchor:hover > a {
            opacity: 0.8;
        }
    }
</style>

<style>
    .post-layout {
        display: flex;
        flex-direction: column;
        padding: 1rem 0.5rem;
        gap: 2rem;
        justify-content: center;
    }

    .content-wrapper {
        display: flex;
        flex-direction: column;
        padding: 1rem;
        border: 1px solid var(--text-main);
        border-radius: 12px;
        background-color: var(--bg-content);
        font-size: 1.1rem;
        height: fit-content;
    }

    .category {
        display: flex;
        flex-direction: row;
        justify-content: flex-start;
        font-weight: 700;
        background-color: var(--bg-page);
        border-radius: 10px;
        width: fit-content;
        padding: 0.5rem;
    }

    .content-wrapper header,
    .content-wrapper article {
        padding: 0 1rem;
    }

    .summary {
        font-size: 1.2rem;
    }

    .cover-image {
        max-width: 100%;
        height: auto;
        border-radius: 10px;
        margin-bottom: 1.5rem;
    }

    .mobile-only-blocks {
        display: flex;
        flex-direction: column;
        gap: 1rem;
        margin: 1.5rem 0;
    }

    .ad-block {
        display: none;
        flex-direction: column;
        gap: 1rem;
        width: 100%;
        padding: 1.5rem 1rem;
        border: 1px solid var(--text-main);
        border-radius: 12px;
        background-color: var(--bg-page);
    }

    .sidebar {
        display: none;
    }

    @media screen and (min-width: 1200px) {
        .mobile-only-blocks {
            display: none;
        }

        .post-layout {
            flex-direction: row;
            padding: 1rem 2.5rem;
        }

        .content-wrapper {
            min-width: 55%;
            max-width: 55%;
            padding: 1rem 2.5rem;
        }

        .content-wrapper header,
        .content-wrapper article {
            padding: initial;
        }

        .sidebar {
            display: flex;
            flex-direction: column;
            min-width: 20%;
            max-width: 20%;
            flex: 1;
            gap: 2rem;
        }

        .ad-block {
            flex-direction: column;
            gap: 1rem;
            padding: 2rem 1rem;
            border: 1px solid var(--text-main);
            border-radius: 12px;
            background-color: var(--bg-content);
        }
    }
</style>
