---
import { Image } from "astro:assets";

const { src, alt, class: className, ...rest } = Astro.props;
const isRemote = typeof src === "string";

let isReachable = true;

if (isRemote) {
    try {
        const response = await fetch(src, { method: "HEAD" });
        if (!response.ok) {
            isReachable = false;
        }
    } catch (error) {
        isReachable = false;
    }
}
---

{
    isReachable ? (
        <Image src={src} alt={alt} class={className} inferSize={isRemote} {...rest} />
    ) : (
        <img src={src} alt={alt} class={className} {...rest} />
    )
}
