---
import { Image } from "astro:assets";

const { src, alt, class: className, ...rest } = Astro.props;
const isRemote = typeof src === "string";

const fallbackUrl = "/fallback-image.jpg";
---

{
    isRemote ? (
        <Image
            src={src}
            alt={alt}
            class={className}
            inferSize={true}
            onerror={`this.onerror=null; this.src='${fallbackUrl}';`}
            {...rest}
        />
    ) : (
        <Image src={src} alt={alt} class={className} {...rest} />
    )
}
