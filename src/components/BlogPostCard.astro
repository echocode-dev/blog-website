---
import { ArrowRight, Calendar } from "@lucide/astro";

const { frontmatter, url } = Astro.props;
var options = { year: "numeric", month: "short", day: "numeric" };
---

<a class="post-card" href={url}>
    <div class="post-info">
        <h3 class="post-title">{frontmatter.title}</h3>
        <div class="post-date">
            <Calendar class="calendar-icon" />
            <p>{frontmatter.pubDate.toLocaleDateString("en-US", options)}</p>
        </div>
        <p class="post-summary">{frontmatter.summary}</p>
    </div>

    <div class="post-go">
        <p>Read more</p>
        <ArrowRight />
    </div>
</a>

<style>
    .post-card {
        display: flex;
        flex-direction: column;
        padding: 1.5rem 1rem;
        border-radius: 5px;
        border: 1px solid var(--text-main);
        background-color: var(--bg-page);
        font-style: normal;
        text-decoration: none;
        justify-content: space-between;
    }

    .post-info {
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }

    .post-title {
        display: -webkit-box;
        -webkit-line-clamp: 1;
        -webkit-box-orient: vertical;
        overflow: hidden;
        margin: 0;
    }

    .post-summary {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
        margin: 0;
    }

    .post-date {
        display: flex;
        flex-direction: row;
        gap: 0.4rem;
        align-items: center;
        color: var(--text-subtle);
        height: 0.9rem;
    }

    .post-go {
        display: flex;
        flex-direction: row;
        align-items: center;
        gap: 0.5rem;
        margin-top: 0.5rem;
    }

    .post-date p,
    .post-go p {
        margin: 0;
    }

    .post-date p {
        font-size: 0.9rem;
    }

    .post-date .calendar-icon {
        width: 20px;
        height: 20px;
    }
</style>
