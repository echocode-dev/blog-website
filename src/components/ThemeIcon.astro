---
import { getLangFromUrl, useTranslations } from "../i18n/utils";
import { Sun, Moon } from "@lucide/astro";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<button id="themeToggle" class="theme-btn" aria-label={t("btn.label.theme")}>
    <Sun class="theme-light-icon" color="var(--text-navbar)" />
    <Moon class="theme-dark-icon" color="var(--text-navbar)" />
</button>

<style>
    .theme-btn {
        background: none;
        display: grid;
        place-items: center;
        position: relative;
        border: 1px solid black;
        box-shadow: 0px 0px 5px black;
        border-radius: 32px;
        padding: 0.5rem;
        transition: opacity 0.3s ease;
    }

    .theme-light-icon,
    .theme-dark-icon {
        grid-area: 1 / 1;
        transition:
            opacity 0.3s ease,
            transform 0.3s ease;
        opacity: 0;
        transform: rotate(-90deg);
        pointer-events: none;
    }

    :global([data-theme="dark"]) .theme-light-icon {
        opacity: 1;
        transform: rotate(0deg);
        pointer-events: auto;
    }

    :global([data-theme="light"]) .theme-dark-icon {
        opacity: 1;
        transform: rotate(0deg);
        pointer-events: auto;
    }

    @media (hover: hover) {
        .theme-btn:hover {
            transition: opacity 0.3s ease;
            opacity: 0.5;
        }
    }
</style>

<script is:inline>
    const themeButton = document.getElementById("themeToggle");

    const handleToggleClick = () => {
        const element = document.documentElement;
        const isDark = element.attributes.getNamedItem("data-theme")?.value == "dark";
        const nextTheme = isDark ? "light" : "dark";

        document.dispatchEvent(new CustomEvent("set-theme", { detail: nextTheme }));
    };

    themeButton?.addEventListener("click", handleToggleClick);
</script>
