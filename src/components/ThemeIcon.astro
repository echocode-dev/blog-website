---
import { Sun, Moon } from "@lucide/astro";
---

<button id="themeToggle" class="theme-btn" aria-label="Toggle theme">
    <Sun class="theme-light-icon" color="var(--text-navbar)" />
    <Moon class="theme-dark-icon" color="var(--text-navbar)" />
</button>

<style>
    .theme-btn {
        background: none;
        border: none;
        cursor: pointer;
        padding: 0;
        display: grid;
        place-items: center;
        position: relative;
        border: 1px solid black;
        box-shadow: 0px 0px 5px black;
        border-radius: 32px;
        padding: 0.5rem;
        transition: opacity 0.3s ease;
    }

    .theme-btn:hover {
        transition: opacity 0.3s ease;
        opacity: 0.5;
    }

    .theme-light-icon,
    .theme-dark-icon {
        grid-area: 1 / 1;
        transition:
            opacity 0.3s ease,
            transform 0.3s ease;
        opacity: 0;
        transform: rotate(-90deg);
        pointer-events: none;
    }

    :global([data-theme="dark"]) .theme-light-icon {
        opacity: 1;
        transform: rotate(0deg);
        pointer-events: auto;
    }

    :global([data-theme="light"]) .theme-dark-icon {
        opacity: 1;
        transform: rotate(0deg);
        pointer-events: auto;
    }
</style>

<script is:inline>
    document.addEventListener("astro:page-load", () => {
        const themeButton = document.getElementById("themeToggle");

        const handleToggleClick = () => {
            const element = document.documentElement;
            const isDark = element.attributes.getNamedItem("data-theme")?.value == "dark";
            const nextTheme = isDark ? "light" : "dark";

            document.dispatchEvent(new CustomEvent("set-theme", { detail: nextTheme }));
        };

        themeButton?.addEventListener("click", handleToggleClick);
    });
</script>
