---
import { Menu } from "@lucide/astro";

const { id } = Astro.props;
---

<button id={id} class="menu-btn" aria-label="Open menu">
    <Menu color="var(--text-navbar)" />
</button>

<style>
    .menu-btn {
        background: none;
        border: none;
        cursor: pointer;
        padding: 0;
        display: flex;
    }
</style>
