---
import { getLangFromUrl, useTranslations } from "../i18n/utils";
import { getRelativeLocaleUrl } from "astro:i18n";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const baseLocaleUrl = getRelativeLocaleUrl(lang, "");
const cleanUrl = baseLocaleUrl.replace(/\/$/, "");
---

<nav class="nav-links">
    <a href={cleanUrl} class="nav-link"><span>{t("nav.featured")}</span></a>
    <a href={`${cleanUrl}/#recents`} class="nav-link"><span>{t("nav.recents")}</span></a>
    <a href={cleanUrl} class="nav-link"><span>{t("nav.blog")}</span></a>
</nav>

<style>
    .nav-links {
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
    }

    .nav-link {
        display: flex;
        text-decoration: none;
    }

    .nav-link span {
        color: var(--text-navbar);
        font-style: normal;
        font-size: 1.2rem;
        padding: 1rem 0;
        border-bottom: 1px solid var(--border-color);
        display: flex;
        text-transform: uppercase;
    }

    @media screen and (min-width: 1200px) {
        .nav-links {
            flex-direction: row;
        }

        .nav-link span {
            font-weight: 600;
            position: relative;
            border: none;
        }

        .nav-link span::after {
            content: "";
            position: absolute;
            left: 0;
            bottom: 0.5rem;
            width: 100%;
            height: 1px;

            background-color: var(--text-navbar);

            transform: scaleX(0);
            transform-origin: center;
            transition: transform 0.3s ease;
        }

        @media (hover: hover) {
            .nav-link span:hover::after {
                transform: scaleX(1);
            }
        }
    }
</style>
