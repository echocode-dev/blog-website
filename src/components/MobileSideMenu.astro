---
import type { Locale } from "../i18n/ui";
import { useTranslations } from "../i18n/utils";
import CloseButton from "./CloseButton.astro";
import SearchBox from "./SearchBox.astro";
import LanguagesButton from "./LanguagesButton.astro";
import NavLinks from "./NavLinks.astro";

interface Props {
    alternateLinks?: { lang: string; url: string }[];
    lang: Locale;
}

const { alternateLinks = [], lang } = Astro.props;
const t = useTranslations(lang);
---

<aside id="side-menu" class="side-menu">
    <div class="side-menu-container">
        <div class="side-menu-header">
            <CloseButton id="close-menu" label={t("btn.label.close")} />

            <div class="langs-button-container">
                <LanguagesButton alternateLinks={alternateLinks} lang={lang} />
            </div>
        </div>

        <SearchBox lang={lang} />

        <NavLinks lang={lang} />

        <div id="mobile-related-posts-target" class="mobile-related-posts-area"></div>
    </div>
</aside>

<style>
    .side-menu {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background-color: var(--bg-navbar);
        z-index: 100;
        border-right: 1px solid var(--border-color);
        overflow: scroll;

        transform: translateX(-100%);
        transition: transform 0.3s ease;
    }

    .side-menu-container {
        display: flex;
        flex-direction: column;
        padding: 1.5rem;
        gap: 2rem;
    }

    .side-menu-header {
        display: flex;
        flex-direction: row;
        justify-content: space-between;
        align-items: center;
    }

    .side-menu.active {
        transform: translateX(0);
    }

    .mobile-related-posts-area {
        color: var(--text-navbar);
        margin-top: 3rem;
        padding-top: 1rem;
        border-top: 1px solid var(--border-color);
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }

    /* HIDES LANGUAGES BUTTON */
    .langs-button-container {
        display: flex;
    }

    @media screen and (min-width: 1200px) {
        .side-menu {
            display: none;
        }
    }
</style>
