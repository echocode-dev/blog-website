---
import CloseButton from "./CloseButton.astro";
import SearchBox from "./SearchBox.astro";
---

<aside id="side-menu" class="side-menu">
    <div class="side-menu-container">
        <div class="side-menu-header">
            <CloseButton id="close-menu" />
        </div>

        <SearchBox />

        <nav class="nav-links">
            <div class="nav-link"><a href="#">Featured</a></div>
            <div class="nav-link"><a href="#">Recents</a></div>
            <div class="nav-link"><a href="#">Blog</a></div>
        </nav>
    </div>
</aside>

<style>
    .side-menu {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background-color: #000;
        z-index: 100;
        border-right: 1px solid #f0ebd8;

        transform: translateX(-100%);
        transition: transform 0.3s ease;
    }

    .side-menu-container {
        display: flex;
        flex-direction: column;
        padding: 1.5rem;
        gap: 2rem;
    }

    .side-menu.active {
        transform: translateX(0);
    }

    .nav-links {
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
    }

    .nav-link {
        display: flex;
    }

    .nav-links a {
        color: white;
        text-decoration: none;
        font-size: 1.2rem;
        padding: 1rem 0;
        border-bottom: 1px solid #f0ebd8;
        display: block;
        text-transform: uppercase;
    }
</style>
