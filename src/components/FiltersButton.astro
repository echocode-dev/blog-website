---
import { Funnel } from "@lucide/astro";

interface Props {
    label: string;
}

const { label } = Astro.props;
---

<button id="filters-btn" class="filters-btn" aria-label={label}>
    <label class="filters-label">{label}</label>
    <Funnel />
</button>

<style>
    .filters-btn {
        display: flex;
        flex-direction: row;
        align-items: center;
        gap: 0.5rem;
        color: var(--text-navbar);
        background: none;
        border: 1px solid var(--border-color);
        border-radius: 32px;
        height: 44px;
        padding: 0.5rem 1rem;
        transition:
            border-color 0.3s ease,
            color 0.3s ease;
    }

    .filters-label {
        font-weight: 600;
        font-size: 1rem;
        pointer-events: none;
    }

    @media (hover: hover) {
        .filters-btn:hover {
            border-color: color-mix(in srgb, var(--border-color), transparent 50%);
            color: color-mix(in srgb, var(--text-navbar), transparent 50%);
        }
    }
</style>

<script>
    const filtersBtn = document.getElementById("filters-btn");
    const filtersContainer = document.getElementById("filters-container");

    filtersBtn?.addEventListener("click", () => {
        filtersContainer?.classList.toggle("active");
    });
</script>
