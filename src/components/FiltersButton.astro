---
import { getLangFromUrl, useTranslations } from "../i18n/utils";
import { Funnel } from "@lucide/astro";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<button id="filters-btn" class="filters-btn" aria-label={t("btn.label.filters")}>
    <label class="filters-label">{t("btn.label.filters")}</label>
    <Funnel />
</button>

<style>
    .filters-btn {
        display: flex;
        flex-direction: row;
        align-items: center;
        gap: 0.5rem;
        color: var(--text-navbar);
        background: none;
        border: 1px solid var(--border-color);
        border-radius: 32px;
        cursor: pointer;
        height: 44px;
        padding: 0.5rem 1rem;
        transition:
            border-color 0.3s ease,
            color 0.3s ease;
    }

    .filters-label {
        font-weight: 600;
        font-size: 14px;
        pointer-events: none;
    }

    @media (hover: hover) {
        .filters-btn:hover {
            border-color: color-mix(in srgb, var(--border-color), transparent 50%);
            color: color-mix(in srgb, var(--text-navbar), transparent 50%);
        }
    }
</style>

<script>
    document.addEventListener("astro:page-load", () => {
        const filtersBtn = document.getElementById("filters-btn");
        const filtersContainer = document.getElementById("filters-container");

        filtersBtn?.addEventListener("click", () => {
            filtersContainer?.classList.toggle("active");
        });
    });
</script>
