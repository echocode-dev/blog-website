---
import { Search } from "@lucide/astro";

const { id } = Astro.props;
---

<button id={id} class="search-btn" aria-label="Search">
    <Search class="search-icon" />
</button>

<style>
    .search-btn {
        color: var(--text-navbar);
        background: none;
        border: 1px solid var(--border-color);
        border-radius: 32px;
        cursor: pointer;
        padding: 0;
        display: flex;
        padding: 0.5rem;
        transition:
            border-color 0.3s ease,
            color 0.3s ease;
    }

    .search-icon {
        transition:
            border-color 0.3s ease,
            color 0.3s ease;
    }

    .search-btn:hover {
        border-color: color-mix(in srgb, var(--border-color), transparent 50%);
        color: color-mix(in srgb, var(--text-navbar), transparent 50%);
    }
</style>
