---
import { Search } from "@lucide/astro";

const { id } = Astro.props;
---

<button id={id} class="menu-btn" aria-label="Search">
    <Search color="var(--text-navbar)" />
</button>

<style>
    .menu-btn {
        background: none;
        border: 1px solid var(--border-color);
        border-radius: 5px;
        cursor: pointer;
        padding: 0;
        display: flex;
        padding: 0.5rem;
    }
</style>
