---
import SearchButton from "./SearchButton.astro";
import { getLangFromUrl } from "../i18n/utils";
import { getRelativeLocaleUrl } from "astro:i18n";

const lang = getLangFromUrl(Astro.url);
const searchUrl = getRelativeLocaleUrl(lang, "search");
---

<search-box class="search-container-wrapper">
    <form action={searchUrl} data-search-url={searchUrl} name="q" class="search-container">
        <input id="search-input" type="text" placeholder="Search" name="q" />
        <SearchButton id="search-btn" />
    </form>
</search-box>

<style>
    .search-container-wrapper {
        flex: 1;
    }

    .search-container {
        display: flex;
        height: 44px;
        gap: 0.5rem;
        align-items: stretch;
    }

    .search-container input {
        flex: 1;
        height: auto;

        color: var(--text-navbar);
        padding: 0 10px;
        border: 1px solid var(--border-color);
        border-radius: 32px;
        background: none;

        box-sizing: border-box;
    }
</style>

<script>
    class SearchBox extends HTMLElement {
        connectedCallback() {
            const form = this.querySelector("form");
            const input = this.querySelector("input");
            const button = this.querySelector("button");

            if (!input || !button || !form) {
                return;
            }

            const checkState = () => {
                const hasText = input.value.trim() !== "";
                const hasFilters = document.querySelectorAll(".filter-checkbox:checked").length > 0;

                button.disabled = !(hasText || hasFilters);
            };

            input.addEventListener("input", checkState);

            document.addEventListener("change", (e) => {
                if (e.target instanceof HTMLElement && e.target.classList.contains("filter-checkbox")) {
                    checkState();
                }
            });

            form.addEventListener("submit", (e) => {
                e.preventDefault();

                const params = new URLSearchParams();

                if (input.value.trim() !== "") {
                    params.set("q", input.value.trim());
                }

                const filters: Record<string, string[]> = {};

                const checkedBoxes = document.querySelectorAll<HTMLInputElement>(".filter-checkbox:checked");

                checkedBoxes.forEach((box) => {
                    const category = box.dataset.category;

                    if (category) {
                        if (!filters[category]) {
                            filters[category] = [];
                        }
                        filters[category].push(box.value);
                    }
                });

                for (const [category, values] of Object.entries(filters)) {
                    params.set(`filter_${category}`, values.join(","));
                }

                const searchUrl = form.getAttribute("data-search-url");
                window.location.assign(`${searchUrl}?${params.toString()}`);
            });
        }
    }

    customElements.define("search-box", SearchBox);
</script>
