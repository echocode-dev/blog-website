---
import SearchButton from "./SearchButton.astro";
---

<form action="/search" name="q" class="search-container">
    <input type="text" placeholder="Search" name="q" />
    <SearchButton />
</form>

<style>
    .search-container {
        display: flex;
        height: 44px;
        gap: 0.5rem;
        align-items: stretch;
        flex: 1;
    }

    .search-container input {
        flex: 1;
        height: auto;

        color: var(--text-navbar);
        padding: 0 10px;
        border: 1px solid var(--border-color);
        border-radius: 32px;
        background: none;

        box-sizing: border-box;
    }
</style>
