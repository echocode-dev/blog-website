---
import { getImage } from "astro:assets";
import FilterButton from "./FilterButton.astro";
import SearchBox from "./SearchBox.astro";
import pageHeaderBackground from "../assets/code.jpg";
import { SITE_TITLE } from "../consts";

const bgImage = await getImage({ src: pageHeaderBackground, format: "webp" });
---

<section class="hero" style={`--bg-image: url(${bgImage.src})`}>
    <div class="hero-content">
        <div class="filter-wrapper" hidden>
            <FilterButton />
        </div>

        <h1>{SITE_TITLE} News</h1>

        <div class="search-wrapper">
            <SearchBox />
        </div>
    </div>
</section>

<style>
    .hero {
        display: flex;
        justify-content: flex-end;
        align-items: flex-end;
        height: 325px;
        padding: 1rem;
        border-radius: 10px;
        margin: 10px 10px 0;
        position: relative;
        z-index: 1;
    }

    .hero::before {
        content: "";
        position: absolute;
        inset: 0;
        z-index: -1;
        border-radius: inherit;
        background-image: linear-gradient(to top, black 50%, transparent), var(--bg-image);
        background-repeat: no-repeat;
        background-size: cover;
        background-position: center center;
    }

    .hero-content {
        display: grid;
        grid-template-columns: auto 1fr;
        gap: 1rem;
        width: 100%;
        align-items: center;
        margin-bottom: 10px;
    }

    .hero-content h1 {
        color: var(--text-navbar);
        grid-column: 1 / -1;
        grid-row: 1;
        text-align: center;
        margin: 0;
        font-size: 1.5rem;
    }

    .filter-wrapper {
        grid-column: 1;
        grid-row: 2;
    }

    .search-wrapper {
        grid-column: 2;
        grid-row: 2;
        display: flex;
        flex-direction: column;
    }

    @media screen and (min-width: 894px) {
        .hero {
            align-items: center;
            margin: 15px 15px 0;
        }

        .hero::before {
            background-image: linear-gradient(to left, black, transparent), var(--bg-image);
        }

        .hero-content {
            grid-template-columns: auto 1fr;
            grid-template-rows: auto auto;
            gap: 0.5rem 1rem;
            align-items: end;
            margin-right: 2rem;
            width: auto;
            min-width: 500px;
        }

        .hero-content h1 {
            grid-column: 2;
            grid-row: 1;
            text-align: left;
        }
    }
</style>
