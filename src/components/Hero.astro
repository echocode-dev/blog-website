---
import { getLangFromUrl, useTranslations } from "../i18n/utils";
import { getImage } from "astro:assets";
import FiltersButton from "./FiltersButton.astro";
import FiltersMenu from "./FiltersMenu.astro";
import SearchBox from "./SearchBox.astro";
import pageHeaderBackground from "../assets/code.jpg";

const bgImage = await getImage({ src: pageHeaderBackground, format: "webp" });
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section class="hero" style={`--bg-image: url(${bgImage.src})`}>
    <div class="hero-content">
        <h1 class="hero-title">{t("hero.title")}</h1>

        <div class="search-wrapper">
            <SearchBox />
        </div>

        <div class="filters-btn-wrapper">
            <FiltersButton />
        </div>

        <div class="filters-menu-wrapper">
            <FiltersMenu />
        </div>
    </div>
</section>

<style>
    .hero {
        display: flex;
        justify-content: flex-end;
        align-items: flex-end;
        height: 325px;
        padding: 1rem;
        border-radius: 10px;
        margin: 10px 10px 0;
        position: relative;
        z-index: 1;
    }

    .hero::before {
        content: "";
        position: absolute;
        inset: 0;
        z-index: -1;
        border-radius: inherit;
        background-image: linear-gradient(to top, black 50%, transparent), var(--bg-image);
        background-repeat: no-repeat;
        background-size: cover;
        background-position: center center;
    }

    .hero-content {
        display: flex;
        flex-direction: column;
        gap: 1rem;
        width: 100%;
        align-items: center;
        margin-bottom: 10px;
        position: relative;
    }

    .hero-title {
        color: var(--text-navbar);
        text-align: center;
        margin: 0;
        font-size: 32px;
    }

    .search-wrapper {
        width: 100%;
    }

    @media screen and (min-width: 894px) {
        .hero {
            align-items: center;
            margin: 15px 15px 0;
        }

        .hero::before {
            background-image: linear-gradient(to left, black, transparent), var(--bg-image);
        }

        .hero-content {
            display: grid;
            grid-template-columns: auto 1fr;
            align-items: end;
            margin-right: 2rem;
            width: auto;
            min-width: 500px;
        }

        .hero-title {
            grid-column: 2;
            grid-row: 1;
            text-align: left;
        }

        .search-wrapper {
            grid-column: 2;
            grid-row: 2;
        }

        .filters-btn-wrapper {
            grid-column: 1;
            grid-row: 2;
        }

        .filters-menu-wrapper {
            grid-row: 3;
        }
    }
</style>
