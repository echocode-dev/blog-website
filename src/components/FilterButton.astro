---
import { Funnel } from "@lucide/astro";

const { id } = Astro.props;
---

<button id={id} class="filter-btn" aria-label="Filter">
    <Funnel />
</button>

<style>
    .filter-btn {
        color: var(--text-secondary);
        background: none;
        border: 1px solid var(--text-subtle);
        border-radius: 32px;
        cursor: pointer;
        padding: 0;
        display: flex;
        padding: 0.5rem;
    }
</style>
