---
import MobileMenuButton from "./MobileMenuButton.astro";
import LogoButton from "./LogoButton.astro";
import MobileSideMenu from "./MobileSideMenu.astro";
import SearchBox from "./SearchBox.astro";
import LanguagesButton from "./LanguagesButton.astro";
import ThemeIcon from "./ThemeIcon.astro";
import NavLinks from "./NavLinks.astro";

interface Props {
    alternateLinks?: { lang: string; url: string }[];
}

const { alternateLinks = [] } = Astro.props;
---

<header id="header" class="header">
    <div class="mobile-menu-button-container">
        <MobileMenuButton id="open-menu" />
    </div>

    <div class="logo-button-container">
        <LogoButton height={40} />
    </div>

    <div class="nav-links-container">
        <NavLinks />
    </div>

    <div class="spacer"></div>

    <div class="search-box-container">
        <SearchBox />
    </div>

    <div class="buttons-container">
        <div class="langs-button-container">
            <LanguagesButton alternateLinks={alternateLinks} />
        </div>

        <div class="theme-button-container">
            <ThemeIcon />
        </div>
    </div>
</header>

<MobileSideMenu alternateLinks={alternateLinks} />

<style>
    .header {
        display: flex;
        align-items: center;
        gap: 1rem;
        border-bottom: 1px solid var(--border-color);
        background-color: var(--bg-navbar);
        position: relative;
        z-index: 50;
        justify-content: space-between;
        padding: 1rem 0.5rem;
        flex-wrap: wrap;
    }

    .logo-button-container {
        display: flex;
        justify-content: center;
        margin: 0px auto;
    }

    .mobile-menu-button-container {
        margin: 0px auto;
    }

    .buttons-container {
        margin: 0px auto;
    }

    .langs-button-container {
        display: none;
    }

    .search-box-container {
        display: none;
    }

    .nav-links-container {
        display: none;
    }

    @media screen and (min-width: 1200px) {
        .header {
            padding: 0.5rem 2.5rem;
        }

        .mobile-menu-button-container {
            display: none;
        }

        .nav-links-container {
            display: block;
        }

        .header {
            gap: 2rem;
        }

        .search-box-container {
            display: flex;
            min-width: 300px;
        }

        .spacer {
            flex: 1;
        }

        .buttons-container {
            display: flex;
            flex-direction: row;
            gap: 1rem;
        }

        /* HIDES LANGUAGES BUTTON */
        .langs-button-container {
            display: none;
        }
    }
</style>
