---
import { getLangFromUrl, useTranslations } from "../i18n/utils";
import { getAbsoluteLocaleUrl } from "astro:i18n";
import MobileMenuButton from "./MobileMenuButton.astro";
import LogoButton from "./LogoButton.astro";
import MobileSideMenu from "./MobileSideMenu.astro";
import SearchBox from "./SearchBox.astro";
import LanguagesButton from "./LanguagesButton.astro";
import ThemeIcon from "./ThemeIcon.astro";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<header id="header" class="header">
    <div class="mobile-menu-button-container">
        <MobileMenuButton id="open-menu" />
    </div>

    <div class="logo-button-container">
        <LogoButton height={40} />
    </div>

    <nav class="nav-links">
        <div class="nav-link"><a href={getAbsoluteLocaleUrl(lang, "")}>{t("nav.featured")}</a></div>
        <div class="nav-link"><a href={getAbsoluteLocaleUrl(lang, "#recents")}>{t("nav.recents")}</a></div>
        <div class="nav-link"><a href={getAbsoluteLocaleUrl(lang, "")}>{t("nav.blog")}</a></div>
    </nav>

    <div class="spacer"></div>

    <div class="search-box-container">
        <SearchBox />
    </div>

    <div class="buttons-container">
        <div class="langs-button-container">
            <LanguagesButton />
        </div>

        <div class="theme-button-container">
            <ThemeIcon />
        </div>
    </div>
</header>

<MobileSideMenu />

<style>
    .header {
        display: flex;
        align-items: center;
        gap: 1rem;
        border-bottom: 1px solid var(--border-color);
        background-color: var(--bg-navbar);
        position: relative;
        z-index: 50;
        justify-content: space-between;
        padding: 1rem 0.5rem;
        flex-wrap: wrap;
    }

    .logo-button-container {
        display: flex;
        justify-content: center;
        margin: 0px auto;
    }

    .mobile-menu-button-container {
        margin: 0px auto;
    }

    .buttons-container {
        margin: 0px auto;
    }

    .langs-button-container {
        display: none;
    }

    .nav-links {
        display: none;
    }

    .search-box-container {
        display: none;
    }

    @media screen and (min-width: 1200px) {
        .header {
            padding: 0.5rem 2.5rem;
        }

        .mobile-menu-button-container {
            display: none;
        }

        .header {
            gap: 2rem;
        }

        .nav-links {
            display: flex;
            gap: 1.5rem;
        }

        .nav-link {
            display: flex;
        }

        .nav-links a {
            color: var(--text-navbar);
            font-weight: 600;
            font-style: normal;
            text-decoration: none;
            font-size: 1.2rem;
            padding: 1rem 0;
            display: block;
            text-transform: uppercase;
            position: relative;
        }

        .nav-links a::after {
            content: "";
            position: absolute;
            left: 0;
            bottom: 0.8rem;
            width: 100%;
            height: 1px;

            background-color: var(--text-navbar);

            transform: scaleX(0);
            transform-origin: center;
            transition: transform 0.3s ease;
        }

        @media (hover: hover) {
            .nav-links a:hover::after {
                transform: scaleX(1);
            }
        }

        .search-box-container {
            display: flex;
            min-width: 300px;
        }

        .spacer {
            flex: 1;
        }

        .buttons-container {
            display: flex;
            flex-direction: row;
            gap: 1rem;
        }

        .langs-button-container {
            display: initial;
        }
    }
</style>
