---
import { ChevronRight } from "@lucide/astro";
const { heading } = Astro.props;
---

<li class="toc-li">
    <div class="article-toc-item">
        <div class="chevron-wrapper">
            <ChevronRight color="var(--text-main)" />
        </div>
        <a href={"#" + heading.slug}>
            {heading.text}
        </a>
    </div>
    {
        heading.subheadings.length > 0 && (
            <ul class="subheadings">
                {heading.subheadings.map((subheading: any) => (
                    <Astro.self heading={subheading} />
                ))}
            </ul>
        )
    }
</li>

<style>
    .article-toc-item {
        display: flex;
        align-items: center;
        gap: 0.4rem;
        transition: all 0.3s ease;
    }

    .chevron-wrapper {
        display: flex;
        transition: transform 0.3s ease;
    }

    .article-toc-item a {
        font-weight: initial;
        font-style: normal;
        text-decoration: none;
        color: var(--text-main);
        transition:
            font-weight 0.3s ease,
            color 0.3s ease;
        display: block;
        padding: 0.2rem 0;
    }

    :global(li.toc-li.active) > .article-toc-item .chevron-wrapper {
        transform: rotate(90deg);
    }

    :global(li.toc-li.active) > .article-toc-item a {
        font-weight: 900;
    }

    li {
        list-style: none;
        text-align: left;
    }

    .subheadings {
        padding-left: 1.5rem;
    }
</style>
