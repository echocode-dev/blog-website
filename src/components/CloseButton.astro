---
import { getLangFromUrl, useTranslations } from "../i18n/utils";
import { X } from "@lucide/astro";

const { id } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<button id={id} class="close-btn" aria-label={t("btn.label.close")}>
    <X color="var(--text-navbar)" />
</button>

<style>
    .close-btn {
        background: none;
        border: none;
        cursor: pointer;
        padding: 0;
        display: flex;
    }

    @media (hover: hover) {
        .close-btn:hover {
            transition: opacity 0.3s ease;
            opacity: 0.5;
        }
    }
</style>
