---
import { X } from "@lucide/astro";

const { id } = Astro.props;
---

<button id={id} class="close-btn" aria-label="Close menu">
    <X color="var(--text-navbar)" />
</button>

<style>
    .close-btn {
        background: none;
        border: none;
        cursor: pointer;
        padding: 0;
        display: flex;
    }

    .close-btn:hover {
        transition: opacity 0.3s ease;
        opacity: 0.5;
    }
</style>
