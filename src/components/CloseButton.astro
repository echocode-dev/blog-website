---
import { X } from "@lucide/astro";

interface Props {
    id: string;
    label: string;
}

const { id, label } = Astro.props;
---

<button id={id} class="close-btn" aria-label={label}>
    <X color="var(--text-navbar)" />
</button>

<style>
    .close-btn {
        background: none;
        border: none;
        padding: 0;
        display: flex;
    }

    @media (hover: hover) {
        .close-btn:hover {
            transition: opacity 0.3s ease;
            opacity: 0.5;
        }
    }
</style>
